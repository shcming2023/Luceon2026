{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "worker-v3.spec02-scope-order-review/1.0.0",
  "title": "Worker V3 Spec 02 bounded scope and reading-order review",
  "type": "object",
  "required": [
    "schema_version",
    "review_id",
    "material_id",
    "source_pdf_sha256",
    "review_status",
    "pages",
    "relationships",
    "open_reviews"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "luceon.worker-v3-spec02-scope-order-review/v1"
    },
    "review_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "material_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_pdf_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "review_status": {
      "type": "string",
      "const": "closed"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "required": [
          "physical_page",
          "scope_status",
          "page_category",
          "reason",
          "complexity_flags",
          "cross_page_relationship_ids",
          "evidence_refs",
          "review_status",
          "units"
        ],
        "properties": {
          "physical_page": {
            "type": "integer",
            "minimum": 1
          },
          "scope_status": {
            "type": "string",
            "enum": [
              "included",
              "excluded"
            ]
          },
          "page_category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "complexity_flags": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "cross_page_relationship_ids": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "evidence_refs": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "review_status": {
            "type": "string",
            "const": "closed"
          },
          "units": {
            "type": "array",
            "maxItems": 100000,
            "items": {
              "type": "object",
              "required": [
                "source_id",
                "scope_status",
                "reason",
                "final_order",
                "semantic_group_id",
                "composite_relationship_ids",
                "evidence_refs",
                "review_status"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "scope_status": {
                  "type": "string",
                  "enum": [
                    "included",
                    "excluded"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "final_order": {
                  "type": "integer",
                  "minimum": 0
                },
                "semantic_group_id": {
                  "type": "string",
                  "maxLength": 1024
                },
                "composite_relationship_ids": {
                  "type": "array",
                  "maxItems": 10000,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                },
                "evidence_refs": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 10000,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "review_status": {
                  "type": "string",
                  "const": "closed"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "relationships": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "required": [
          "relationship_id",
          "relationship_type",
          "member_source_ids",
          "roles",
          "physical_pages",
          "evidence_refs",
          "review_status"
        ],
        "properties": {
          "relationship_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "relationship_type": {
            "type": "string",
            "enum": [
              "semantic_group",
              "cross_page_group",
              "stem_media_options"
            ]
          },
          "member_source_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "roles": {
            "type": "object",
            "required": [
              "stem",
              "media",
              "options"
            ],
            "properties": {
              "stem": {
                "type": "array",
                "maxItems": 100000,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              },
              "media": {
                "type": "array",
                "maxItems": 100000,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              },
              "options": {
                "type": "array",
                "maxItems": 100000,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              }
            },
            "additionalProperties": false
          },
          "physical_pages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100000,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "review_status": {
            "type": "string",
            "const": "closed"
          }
        },
        "additionalProperties": false
      }
    },
    "open_reviews": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}

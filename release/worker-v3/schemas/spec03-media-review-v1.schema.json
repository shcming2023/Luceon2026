{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "worker-v3.spec03-media-review/1.0.0",
  "title": "Worker V3 Spec 03 bounded media disposition review",
  "type": "object",
  "required": [
    "schema_version",
    "review_id",
    "material_id",
    "source_pdf_sha256",
    "review_status",
    "media",
    "open_reviews"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "luceon.worker-v3-spec03-media-review/v1"
    },
    "review_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "material_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_pdf_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "review_status": {
      "type": "string",
      "const": "closed"
    },
    "media": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "required": [
          "media_id",
          "disposition",
          "selected_candidate_id",
          "source_ids",
          "evidence_refs",
          "review_status"
        ],
        "properties": {
          "media_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "disposition": {
            "type": "string",
            "enum": [
              "source_asset",
              "source_region",
              "structured_transcription",
              "excluded_noninstructional"
            ]
          },
          "selected_candidate_id": {
            "type": "string",
            "maxLength": 2048
          },
          "source_ids": {
            "type": "array",
            "maxItems": 100000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "review_status": {
            "type": "string",
            "const": "closed"
          }
        },
        "additionalProperties": false
      }
    },
    "open_reviews": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}

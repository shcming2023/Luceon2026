{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "worker-v3-spec04b-semantic-compact-review-v1.schema.json",
  "title": "Worker V3 Spec 04-B compact semantic decisions",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "review_status",
    "decisions",
    "open_reviews"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "luceon.worker-v3-spec04b-compact-review/v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "review_status": {
      "const": "closed"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
      "required": [
        "candidate_index",
        "disposition",
        "semantic_role"
      ],
        "additionalProperties": false,
        "properties": {
          "candidate_index": {
            "type": "integer",
            "minimum": 0
          },
          "disposition": {
            "enum": [
              "plain_body",
              "standalone_label",
              "teaching_group"
            ]
          },
          "semantic_role": {
            "enum": [
              "plain_body",
              "activity",
              "answer",
              "assessment",
              "definition",
              "example",
              "exercise",
              "experiment",
              "investigation",
              "key_point",
              "method_note",
              "note",
              "practice",
              "prompt",
              "source_label",
              "summary",
              "tip",
              "vocabulary",
              "worked_example"
            ]
        }
      }
      }
    },
    "open_reviews": {
      "const": []
    }
  }
}

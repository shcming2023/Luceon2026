{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spec05-build-policy.schema.json",
  "title": "Spec 05 build policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "template_metadata_constraints", "compile", "render"],
  "properties": {
    "schema_version": {"const": "spec05-build-policy/1.0"},
    "status": {"const": "approved"},
    "template_metadata_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_nonempty"],
      "properties": {
        "required_nonempty": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["title", "subtitle", "author", "institute", "date", "extrainfo"]}
        }
      }
    },
    "compile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executor", "container", "entry", "engine", "minimum_tex", "command", "max_runs", "timeout_seconds"],
      "properties": {
        "executor": {"enum": ["direct_exec", "docker_copy_exec"]},
        "container": {"type": "string", "minLength": 1},
        "entry": {"const": "main.tex"},
        "engine": {"type": "string", "minLength": 1},
        "minimum_tex": {"type": "string", "minLength": 1},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "environment": {"type": "object", "additionalProperties": {"type": "string"}},
        "max_runs": {"type": "integer", "minimum": 1, "maximum": 10},
        "timeout_seconds": {"type": "integer", "minimum": 60}
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["renderer", "format", "dpi", "color_space", "timeout_seconds"],
      "properties": {
        "renderer": {"enum": ["pdftoppm", "pdftocairo"]},
        "format": {"const": "png"},
        "dpi": {"type": "integer", "minimum": 72, "maximum": 600},
        "color_space": {"type": "string", "minLength": 1},
        "timeout_seconds": {"type": "integer", "minimum": 60}
      }
    }
  }
}

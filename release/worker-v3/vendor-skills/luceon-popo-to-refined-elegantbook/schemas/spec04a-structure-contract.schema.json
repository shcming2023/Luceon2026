{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spec04a-structure-contract.schema.json",
  "title": "Spec 04-A source TOC, body hierarchy, and final TOC contract",
  "type": "object",
  "required": [
    "schema_version",
    "contract_id",
    "slice_status",
    "full_spec04_status",
    "parent",
    "source_outline_evidence",
    "source_toc_entries",
    "body_hierarchy",
    "title_candidate_disposition",
    "final_toc_entries",
    "prohibitions",
    "summary"
  ],
  "properties": {
    "schema_version": {"const": "spec04a-structure-contract/1.0"},
    "slice_status": {"const": "passed"},
    "full_spec04_status": {"const": "not_evaluated"},
    "source_toc_entries": {"type": "array"},
    "body_hierarchy": {"type": "array", "minItems": 1},
    "final_toc_entries": {"type": "array", "minItems": 1},
    "title_candidate_disposition": {
      "type": "object",
      "required": ["inventory_payload_hash", "candidate_count", "structural_title_blocks", "local_heading_blocks", "unresolved"],
      "properties": {"unresolved": {"const": 0}}
    }
  },
  "additionalProperties": true
}

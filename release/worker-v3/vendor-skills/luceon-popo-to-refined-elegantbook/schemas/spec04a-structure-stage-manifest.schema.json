{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spec04a-structure-stage-manifest.schema.json",
  "title": "Spec 04-A immutable stage commit manifest",
  "type": "object",
  "required": [
    "schema_version",
    "stage_kind",
    "run_id",
    "status",
    "slice_status",
    "full_spec04_status",
    "producer",
    "producer_mode",
    "commit_order",
    "parent_promotion",
    "execution_capability_E",
    "decision_index_D",
    "ledger_L",
    "source_outline_ledger",
    "final_toc_plan",
    "review_queue",
    "validation",
    "scope_prohibitions"
  ],
  "properties": {
    "schema_version": {"const": "spec04a-structure-stage-manifest/1.0"},
    "stage_kind": {"const": "spec04a_structure_contract"},
    "status": {"const": "passed"},
    "slice_status": {"const": "passed"},
    "full_spec04_status": {"const": "not_evaluated"},
    "producer_mode": {"enum": ["formal_native", "migration_compatibility"]},
    "commit_order": {
      "const": [
        "precommit_evidence_and_execution_capability_E",
        "decision_index_D",
        "structure_contract_and_ledger_L",
        "stage_manifest_M"
      ]
    }
  },
  "additionalProperties": true
}

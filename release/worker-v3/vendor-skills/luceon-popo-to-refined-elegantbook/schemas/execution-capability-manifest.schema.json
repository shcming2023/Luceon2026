{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luceon.local/schemas/execution-capability-manifest.schema.json",
  "title": "Exact execution capability snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_id",
    "status",
    "producer",
    "skill",
    "entrypoints",
    "local_code_closure",
    "resources",
    "runtime",
    "dependencies",
    "invocation",
    "closure_policy",
    "summary",
    "payload_hash"
  ],
  "properties": {
    "schema_version": {"const": "execution-capability-manifest/1.0"},
    "manifest_id": {"type": "string", "minLength": 1},
    "status": {"const": "passed"},
    "producer": {"type": "string", "minLength": 1},
    "skill": {
      "type": "object",
      "required": ["name", "root", "contracts"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "root": {"type": "string", "minLength": 1},
        "contracts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}
      }
    },
    "entrypoints": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "local_code_closure": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "resources": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "runtime": {
      "type": "object",
      "required": ["python", "platform"],
      "properties": {
        "python": {
          "type": "object",
          "required": ["implementation", "version", "cache_tag", "executable_path", "executable_sha256"],
          "properties": {"executable_sha256": {"$ref": "#/$defs/sha256"}}
        },
        "platform": {"type": "object", "required": ["system", "release", "machine"]}
      }
    },
    "dependencies": {"type": "array"},
    "invocation": {
      "type": "object",
      "required": ["argv", "argv_sha256", "redaction_count", "environment_values_recorded"],
      "properties": {
        "argv": {"type": "array", "items": {"type": "string"}},
        "argv_sha256": {"$ref": "#/$defs/sha256"},
        "redaction_count": {"type": "integer", "minimum": 0},
        "environment_values_recorded": {"const": false}
      }
    },
    "closure_policy": {
      "type": "object",
      "required": ["whole_skill_directory_hashed", "undeclared_local_imports_allowed", "secrets_recorded"],
      "properties": {
        "whole_skill_directory_hashed": {"const": false},
        "undeclared_local_imports_allowed": {"const": false},
        "secrets_recorded": {"const": false}
      }
    },
    "payload_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "required": ["role", "path", "logical_path", "path_basis", "size_bytes", "sha256"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "logical_path": {"type": "string", "minLength": 1},
        "path_basis": {"enum": ["skill_root", "absolute"]},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "additionalProperties": true
}

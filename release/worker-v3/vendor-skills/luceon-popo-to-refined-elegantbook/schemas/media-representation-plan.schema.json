{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luceon.local/schemas/media-representation-plan.schema.json",
  "title": "Media Representation Plan",
  "type": "object",
  "required": ["schema_version", "media_evidence_ledger_sha256", "spec_status", "open_reviews", "representations", "payload_hash"],
  "properties": {
    "schema_version": {"enum": ["media-representation-plan/1.0", "media-representation-plan/1.1"]},
    "canonical_ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "media_evidence_ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "spec_status": {"enum": ["blocked", "failed", "needs_review", "passed"]},
    "open_reviews": {"type": "integer", "minimum": 0},
    "representations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["representation_id", "media_id", "status", "selected_candidate_id", "representation_type", "rule_id", "decision_refs"],
        "properties": {
          "representation_id": {"type": "string", "minLength": 1},
          "media_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["closed", "needs_review", "excluded"]},
          "selected_candidate_id": {"type": ["string", "null"]},
          "representation_type": {
            "type": ["string", "null"],
            "enum": ["source_asset_image", "source_region_image", "structured_formula", "structured_table", "structured_chart", "vector_reconstruction", null]
          },
          "rule_id": {"type": "string"},
          "decision_refs": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "payload_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}

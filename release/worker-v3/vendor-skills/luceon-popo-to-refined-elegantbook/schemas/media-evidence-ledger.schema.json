{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luceon.local/schemas/media-evidence-ledger.schema.json",
  "title": "Media Evidence Ledger",
  "type": "object",
  "required": ["schema_version", "ledger_id", "source_pdf", "atoms", "payload_hash"],
  "properties": {
    "schema_version": {"enum": ["media-evidence-ledger/1.0", "media-evidence-ledger/1.1"]},
    "canonical_ledger": {"type": "object"},
    "decision_index": {"type": "object"},
    "ledger_id": {"type": "string", "minLength": 1},
    "source_pdf": {
      "type": "object",
      "required": ["path", "sha256", "page_count"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "page_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "atoms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["media_id", "source_block_ids", "inclusion_status", "media_kind", "source_page", "candidates", "review_status"],
        "properties": {
          "media_id": {"type": "string", "minLength": 1},
          "source_block_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "inclusion_status": {"enum": ["included", "excluded", "needs_review"]},
          "media_kind": {"enum": ["image", "formula", "table", "chart", "diagram", "visual_region", "other", "unknown"]},
          "source_page": {"type": "integer", "minimum": 1},
          "candidates": {"type": "array", "minItems": 1, "items": {"type": "object"}},
          "review_status": {"enum": ["closed", "needs_review"]}
        },
        "additionalProperties": true
      }
    },
    "payload_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}

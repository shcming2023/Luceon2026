{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luceon.local/schemas/worker-v3-skill-release-v1.json",
  "title": "Luceon Worker V3 immutable skill release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "version",
    "channel",
    "status",
    "created_at",
    "source",
    "eligibility",
    "tree_hash",
    "archive_hash_location",
    "files",
    "skills",
    "specs",
    "schemas",
    "entrypoints",
    "dynamic_closure",
    "prompts",
    "model_policy",
    "template",
    "runtime",
    "limits",
    "evidence",
    "compatibility"
  ],
  "properties": {
    "schema_version": {
      "const": "luceon.worker-v3-skill-release/v1"
    },
    "release_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "channel": {
      "enum": ["rc", "stable"]
    },
    "status": {
      "enum": ["incomplete", "rc", "stable"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_sha", "git_tag", "dirty"],
      "properties": {
        "git_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "git_tag": {
          "type": ["string", "null"]
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rc_eligible", "stable_eligible"],
      "properties": {
        "rc_eligible": {
          "type": "boolean"
        },
        "stable_eligible": {
          "type": "boolean"
        }
      }
    },
    "tree_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "sha256"],
      "properties": {
        "algorithm": {
          "const": "sha256-canonical-file-records-v1"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "archive_hash_location": {
      "const": "external-release-registry"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256", "mode", "role"],
        "properties": {
          "path": {
            "$ref": "#/$defs/relativePath"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "mode": {
            "enum": ["0444", "0555"]
          },
          "role": {
            "enum": [
              "skills",
              "contracts",
              "schemas",
              "validators",
              "prompts",
              "scripts",
              "references",
              "templates",
              "evals",
              "runtime"
            ]
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/versionedIdentity"
      }
    },
    "specs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/versionedIdentity"
      }
    },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/versionedIdentity"
      }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formal",
        "legacy",
        "migration",
        "diagnostic",
        "prohibited",
        "definitions"
      ],
      "properties": {
        "formal": {
          "$ref": "#/$defs/entrypointIds"
        },
        "legacy": {
          "$ref": "#/$defs/entrypointIds"
        },
        "migration": {
          "$ref": "#/$defs/entrypointIds"
        },
        "diagnostic": {
          "$ref": "#/$defs/entrypointIds"
        },
        "prohibited": {
          "$ref": "#/$defs/entrypointIds"
        },
        "definitions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "classification",
              "execution_role",
              "stage",
              "argv",
              "input_schema",
              "output_schema",
              "permission_envelope",
              "timeout_seconds",
              "exit_semantics"
            ],
            "properties": {
              "classification": {
                "enum": [
                  "formal",
                  "legacy",
                  "migration",
                  "diagnostic",
                  "prohibited"
                ]
              },
              "execution_role": {
                "enum": [
                  "producer",
                  "evaluator",
                  "utility"
                ]
              },
              "stage": {
                "type": "string",
                "minLength": 1
              },
              "argv": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "input_schema": {
                "$ref": "#/$defs/relativePath"
              },
              "output_schema": {
                "$ref": "#/$defs/relativePath"
              },
              "permission_envelope": {
                "type": "string",
                "minLength": 1
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 86400
              },
              "exit_semantics": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "dynamic_closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modules", "resources"],
      "properties": {
        "modules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        }
      }
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "path", "sha256", "output_schema"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "$ref": "#/$defs/relativePath"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "output_schema": {
            "$ref": "#/$defs/relativePath"
          }
        }
      }
    },
    "model_policy": {
      "type": "object"
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "archive_path",
        "archive_sha256",
        "tree_sha256",
        "main_sha256",
        "class_sha256",
        "fixed_assets_sha256",
        "capabilities_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "archive_path": {
          "$ref": "#/$defs/relativePath"
        },
        "archive_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "tree_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "main_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "class_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "fixed_assets_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "capabilities_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "application_dependencies_sha256",
        "system_tools",
        "fonts_sha256",
        "tex_sha256",
        "poppler_sha256",
        "container_image_digest",
        "sbom_path",
        "attestations"
      ],
      "properties": {
        "python": {
          "type": "string",
          "minLength": 1
        },
        "application_dependencies_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "system_tools": {
          "type": "object"
        },
        "fonts_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "tex_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "poppler_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "container_image_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "sbom_path": {
          "$ref": "#/$defs/relativePath"
        },
        "attestations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivery_zip_bytes_exclusive_max",
        "raster_bytes_exclusive_max",
        "file_count_exclusive_max",
        "tex_leaf_bytes_exclusive_max"
      ],
      "properties": {
        "delivery_zip_bytes_exclusive_max": {
          "const": 50000000
        },
        "raster_bytes_exclusive_max": {
          "const": 1000000
        },
        "file_count_exclusive_max": {
          "const": 2000
        },
        "tex_leaf_bytes_exclusive_max": {
          "const": 900000
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "contract", "eval", "uat", "known_gaps"],
      "properties": {
        "unit": {
          "type": "array"
        },
        "contract": {
          "type": "array"
        },
        "eval": {
          "type": "array"
        },
        "uat": {
          "type": "array"
        },
        "known_gaps": {
          "type": "array"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v2_3", "rollback"],
      "properties": {
        "v2_3": {
          "type": "string",
          "minLength": 1
        },
        "rollback": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "entrypointIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "versionedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "path", "sha256"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}

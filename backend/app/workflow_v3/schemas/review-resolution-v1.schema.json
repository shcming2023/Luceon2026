{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "luceon.worker-v3.review-resolution/v1",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "evaluation",
    "authorization",
    "blocker_resolutions",
    "recovery_stage",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "luceon.worker-v3.review-resolution/v1"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "evaluation": {
      "type": "object",
      "required": [
        "id",
        "sha256",
        "candidate_id",
        "candidate_sha256",
        "finding_fingerprints"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "finding_fingerprints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "required": [
        "authorized_by",
        "decision"
      ],
      "properties": {
        "authorized_by": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "const": "revise"
        }
      },
      "additionalProperties": false
    },
    "blocker_resolutions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "finding_fingerprint",
          "disposition",
          "rationale"
        ],
        "properties": {
          "finding_fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "disposition": {
            "type": "string",
            "const": "resolved_for_revision"
          },
          "rationale": {
            "type": "string",
            "minLength": 3,
            "maxLength": 4000
          }
        },
        "additionalProperties": false
      }
    },
    "recovery_stage": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}

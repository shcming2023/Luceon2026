{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "luceon.worker-v3.bounded-decision/v1",
  "type": "object",
  "required": [
    "decisions"
  ],
  "properties": {
    "decisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "selected_option_id",
          "confidence",
          "reason"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "selected_option_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
